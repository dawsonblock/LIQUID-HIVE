# LIQUID-HIVE example environment
# Copy to .env and adjust as needed for local runs

# Provider selection for router: vllm | openai | hf_cpu | auto
MODEL_PROVIDER=auto

# vLLM
VLLM_ENDPOINT=http://vllm:8000
VLLM_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HF CPU provider
HF_MODEL=
ALLOW_SMALL_HF_MODEL=1

# Router timeout per provider in milliseconds
PROVIDER_TIMEOUT_MS=120000

# Optional: Prometheus
PROMETHEUS_BASE_URL=http://prometheus:9090